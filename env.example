# Note: For Docker, environment variables are set in docker-compose.yml
# This file is for local development reference only.

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGODB_URI=mongodb://admin:password123@localhost:27017/youtube_trends?authSource=admin

# Application Configuration
NODE_ENV=development
PORT=5000
REACT_APP_API_URL=http://localhost:5000/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
